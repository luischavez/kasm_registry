{
  "friendly_name": "Orca Slicer",
  "description": "Orca Slicer is a fork of Bambu Studio.",
  "image_src": "orcaslicer.png",
  "docker_registry": "ghcr.io",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ghcr.io/michaeljones32/kasm-orcaslicer:latest",
      "uncompressed_size_mb": 3450,
      "available_tags": [
        "latest"
      ]
    }
  ]
}